-- Selecionando tudo e limitando a 1000 entradas
SELECT * FROM `composite-shard-514100-b5.99999999.student_grades` LIMIT 1000

-- Selecionando apenas algumas colunas
SELECT final_grade_pct, scholarship_status FROM `composite-shard-514100-b5.99999999.student_grades`

-- Vendo os valores distintos
SELECT DISTINCT scholarship_status FROM `composite-shard-514100-b5.99999999.student_grades`

-- Contando quantos valores distintos numa coluna
SELECT COUNT(DISTINCT residence_type) FROM `composite-shard-514100-b5.99999999.student_grades`

-- Salvando os valores distintos numa table diferente 
SELECT COUNT(*) AS DistinctResidence FROM (SELECT DISTINCT residence_type FROM `composite-shard-514100-b5.99999999.student_grades`)

-- Filtrando só onde risk_flag = 1
SELECT * FROM `composite-shard-514100-b5.99999999.student_grades`
WHERE at_risk_flag = 1

-- Filtrando com operadores
SELECT * FROM `composite-shard-514100-b5.99999999.student_grades`
WHERE final_grade_pct > 70

--- Ordenando
SELECT * FROM `composite-shard-514100-b5.99999999.student_grades`
WHERE at_risk_flag = 1
ORDER BY extra_tutoring, final_grade_pct DESC